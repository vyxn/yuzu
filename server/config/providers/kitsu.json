{
  "type": "http",
  "inputs": {
    "series": "%series%",
    "chapter": "%chapter%"
  },
  "vars": {
    "%baseUrl%": "https://kitsu.io/api/edge"
  },
  "http": {
    "requestsPerSecond": 10
  },
  "endpoints": [
    {
      "method": "GET",
      "url": "%baseUrl%/manga",
      "params": {
        "filter[text]": "%series%"
      },
      "responseType": "json",
      "cache": true,
      "result": {
        "%seriesLink%": "$.data[0].links.self"
      }
    },
    {
      "method": "GET",
      "url": "%seriesLink%",
      "responseType": "json",
      "cache": true,
      "result": {
        "%seriesId%": "$.data.id",
        "%seriesName%": "$.data.attributes.canonicalTitle"
      }
    },
    {
      "method": "GET",
      "url": "%baseUrl%/manga/%seriesId%/chapters",
      "responseType": "json",
      "cache": true,
      "params": {
        "filter[number]": "%chapter%"
      },
      "result": {
        "%chapterTitle%": "$.data[0].attributes.canonicalTitle",
        "%chapterNumber%": "$.data[0].attributes.number",
        "%chapterDescription%": "$.data[0].attributes.description"
      }
    }
  ],
  "output": {
    "type": "xml",
    "schema": "https://raw.githubusercontent.com/anansi-project/comicinfo/refs/heads/main/drafts/v2.1/ComicInfo.xsd",
    "content": {
      "ComicInfo": {
        "Series": "%seriesName%",
        "Title": "%chapterTitle%",
        "Number": "%chapterNumber%",
        "Summary": "%chapterDescription%"
      }
    }
  }
}
