{
  "path": "testlib",
  "selectors": [
    {
      "type": "dir",
      "regex": ".*/([^/]+)/?$",
      "captures": {
        "%dir%": 0,
        "%series%": 1
      }
    },
    {
      "type": "file",
      "regex": "(?i)^.*?(?:chapter|ch|c)?\\s?(\\d+).*\\.cbz$",
      "captures": {
        "%chapter%": 1
      }
    }
  ],
  "jobs": [
    {
      "schedule": "* 0 * * *",
      "output": {
        "id": "comicinfo",
        "path": "%dir%/%chapter%.ComicInfo.xml"
      },
      "providers": [
        {
          "id": "myanimelist",
          "inputs": {
            "series": "%series%",
            "chapter": "%chapter%"
          },
          "output": {
            "ComicInfo": {
              "Summary": 0
            }
          }
        }
      ]
    }
  ],
  "settings": {
    "providers": {
      "merge": true
    }
  }
}
